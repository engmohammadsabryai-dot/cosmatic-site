{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      ".git/**",
      "**/.firebase/**",
      ".firebase/**",
      "**/.snapshots/**",
      ".snapshots/**",
      "**/node_modules/**",
      "**/*.MOV",
      "*.MOV",
      "**/*.ps1",
      "*.ps1",
      "**/*.py",
      "*.py",
      "**/*.bat",
      "*.bat",
      "**/*.txt",
      "*.txt",
      "**/*.log",
      "*.log",
      "*.html.bak",
      "tg_page.html"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=7200"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
